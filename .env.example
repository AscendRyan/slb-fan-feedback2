# Client-side override. Leave this empty in most Vercel deployments so the app posts to /api/submit.
# VITE_SURVEY_ENDPOINT=/api/submit

# Option A: Google Sheets via a Google Apps Script web app URL.
# Recommended if you want responses in a spreadsheet.
GOOGLE_SHEETS_WEBHOOK_URL=

# Option B: Generic server-to-server webhook, for example Make, Zapier, n8n, or Airtable automation.
SUBMISSION_WEBHOOK_URL=

# Option C: Vercel Postgres / Neon / Postgres integration.
# Vercel integrations usually add POSTGRES_URL automatically.
POSTGRES_URL=

# Optional: set this locally when testing a Vercel-like environment.
# NODE_VERSION=24
